{
  "name": "hono-api-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/prisma.integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "knip": "knip",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/hono-api-reference": "^0.12.18",
    "better-auth": "^1.7.18",
    "dotenv": "^18.0.9",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
